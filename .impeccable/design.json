  "narrative": {
    "northStar": "Race programme",
    "overview": "A compact, energetic training companion. Strong cobalt fields, warm paper, confident Albert Sans and a pale lime action give the interface the directness of a race programme. Information stays compact and readable; crisp rules separate supporting records.",
    "keyCharacteristics": [
      "Cobalt fields with a lime logging action.",
      "Compact typography with large, tightly spaced workout titles.",
      "Flat surfaces, small corners and clear state changes."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair status color with a visible status label or an accessible session description.",
        "section": "colors"
      },
      {
        "name": "The Compact Week Rule",
        "body": "Keep the five-session preview on one row, using concise labels and authored SVG marks.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use the embedded Albert Sans family through its Programme alias.",
      "**Do** keep supporting surfaces flat and separate records with crisp rules.",
      "**Do** retain visible keyboard focus and textual status information.",
      "**Do** preserve mobile target sizes and clearance above bottom navigation."
    ],
    "donts": [
      "**Don't** treat a completed fill as the only indication of session status.",
      "**Don't** add raised card shadows to ordinary session records."
    ]
  }
